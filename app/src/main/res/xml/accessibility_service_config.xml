<?xml version="1.0" encoding="utf-8"?>
<!--
  What each capability is used for (also explained inside the app on the Setup screen):
  - canPerformGestures      : replay the taps / swipes you recorded (dispatchGesture)
  - canRequestFilterKeyEvents: record Back / Home / Recents presses and detect the
                               Volume Up + Volume Down emergency stop. Only switched on
                               while recording or running a macro. Typed text is never stored.
  - window state events     : only to learn WHICH app is in front (for "Only run in this app").
  The service cannot read screen content (canRetrieveWindowContent = false).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.mareco.app.ui.MainActivity" />
