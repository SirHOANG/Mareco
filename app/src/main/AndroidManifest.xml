<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permission Mareco declares is VIBRATE (haptic feedback).
      There is NO internet permission: Mareco never talks to the network.
      Floating controls are drawn through the accessibility service, so the
      "Display over other apps" permission is not needed either.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets Mareco show the name of the app a macro was recorded in (launcher apps only). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MarecoApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mareco">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open shared .mareco files -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-mareco" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mareco" />
            </intent-filter>
        </activity>

        <!-- Small dialog-style screen used for text input (naming a recording, renaming a macro).
             A real window is needed for the keyboard, so this is not drawn inside the overlay. -->
        <activity
            android:name=".ui.PromptActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Mareco.Dialog"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Shows the error text after a crash. Own process, so it opens even if the app is broken. -->
        <activity
            android:name=".ui.CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":crash"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <service
            android:name=".service.MarecoAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name=".share.MacroShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
